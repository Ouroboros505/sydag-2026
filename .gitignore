# local packages — installed per machine, never committed
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# build output
dist/
*.tsbuildinfo
dev-dist/

# data stays out of git
data/raw/*
data/processed/*
!data/**/.gitkeep

# local secrets / notes
.env
.env.local
*.local.md

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# outputs
outputs/
*.log
