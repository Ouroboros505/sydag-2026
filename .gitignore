# local packages — installed per machine, never committed
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# build output
dist/
*.tsbuildinfo
dev-dist/

# data stays out of git
data/raw/*
data/processed/*
!data/**/.gitkeep

# local secrets / notes
.env
.env.local
*.local.md

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# outputs
outputs/
*.log

# wrangler local state
.wrangler/

# written by the pipeline from the competition data, which is not ours to publish
public/recommendations.json
public/season_lines.json
docs/advance_2008*.csv
